# DOR PRIZE game server (backend)
PORT=3001
# Comma-separated origins allowed to call REST + Socket.io (the web app).
# Add your Vercel URL for the live demo, e.g. http://localhost:3000,https://dor-prize.vercel.app
CORS_ORIGINS=http://localhost:3000
# 1 = fill rooms with server-side bots (handy for solo testing).
ALLOW_BOTS=0
BOTS_PER_ROOM=3
# <1 speeds every phase up (0.2 = 5x faster). 1 = real PRD timing.
TIME_SCALE=1
# Running game with no connected player is dropped after this long (ms).
IDLE_GAME_TTL_MS=120000
