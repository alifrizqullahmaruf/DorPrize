# DOR PRIZE game server (backend)
PORT=3001
# Comma-separated origins allowed to call REST + Socket.io (the web app).
# Add the live site for the demo, e.g. http://localhost:3000,https://dorprize.xyz,https://www.dorprize.xyz
CORS_ORIGINS=http://localhost:3000
# 1 = fill rooms with server-side bots (handy for solo testing).
ALLOW_BOTS=0
BOTS_PER_ROOM=3
# <1 speeds every phase up (0.2 = 5x faster). 1 = real PRD timing.
TIME_SCALE=1
# Running game with no connected player is dropped after this long (ms).
IDLE_GAME_TTL_MS=120000

# On-chain bids (RoomManager on Monad testnet). Players sign in with their wallet,
# bids are locked on join, the server calls startRoom and pays the pot (settleRoom).
ONCHAIN=0
# Foundry keystore of the RoomManager backendSigner/operator (default ~/.foundry/keystores/deployer).
# Its password is asked on the terminal at start: run `npm run start:backend`.
SIGNER_KEYSTORE=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
