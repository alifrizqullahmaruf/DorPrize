# Copy to backend/.env. Never commit the populated file.
SERVER_MODE=native
PORT=3001
CORS_ORIGINS=https://dorprize.vercel.app,http://localhost:3000
AUTH_ORIGIN=https://dorprize.vercel.app
ALLOW_BOTS=0
TIME_SCALE=1

CHAIN_ID=10143
MONAD_RPC_URL=
NATIVE_GAME_VAULT_ADDRESS=
# Server signing accounts must match deployed roles; separate accounts are recommended.
# Configure through hosting secrets; never use NEXT_PUBLIC_* or send keys in chat.
OPERATOR_PRIVATE_KEY=
BACKEND_SIGNER_PRIVATE_KEY=

# Supabase DIRECT or SESSION connection URL (not transaction pooling).
# For verified Supabase TLS, add query parameters:
# sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt
# Path is relative to backend/ when using the workspace start command; see certs/README.md.
DATABASE_URL=
# Local alternative only: durable directory, one writer. Leave DATABASE_URL empty.
# NATIVE_STATE_DIR=.native-state
# Local Anvil tests only: CHAIN_ID=31337, localhost RPC and NATIVE_ALLOW_LOCAL=1.
