# DOR PRIZE frontend
# mock = in-browser server + bots; socket = real backend (backend, run `npm run dev:backend`)
NEXT_PUBLIC_GAME_TRANSPORT=mock
# 1 = demo wallet in the browser (no RPC/wallet needed). Set 0 + fill Reown/contracts for on-chain.
NEXT_PUBLIC_DEMO_OFFLINE=1
# Game server URL for socket mode, e.g. http://localhost:3001
NEXT_PUBLIC_BACKEND_API_URL=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_MONAD_CHAIN_ID=0x279F
NEXT_PUBLIC_MONAD_CHAIN_NAME=Monad Testnet
NEXT_PUBLIC_MONAD_RPC_URLS=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URLS=https://testnet.monadexplorer.com
NEXT_PUBLIC_MONAD_NATIVE_NAME=MON
NEXT_PUBLIC_MONAD_NATIVE_SYMBOL=MON
NEXT_PUBLIC_MONAD_NATIVE_DECIMALS=18
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_FAUCET_ADDRESS=
NEXT_PUBLIC_GAME_VAULT_ADDRESS=
NEXT_PUBLIC_ROOM_MANAGER_ADDRESS=
