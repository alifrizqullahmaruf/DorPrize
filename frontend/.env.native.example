# Native MON mode on Monad Testnet. No Reown project ID is needed for injected MetaMask.
NEXT_PUBLIC_ASSET_MODE=native
NEXT_PUBLIC_DEMO_OFFLINE=0
NEXT_PUBLIC_GAME_TRANSPORT=socket
NEXT_PUBLIC_BACKEND_API_URL=
# Uses the confirmed deployment registry if this override is empty.
NEXT_PUBLIC_NATIVE_GAME_VAULT_ADDRESS=
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_CHAIN_NAME=Monad Testnet
NEXT_PUBLIC_MONAD_RPC_URLS=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URLS=https://testnet.monadvision.com
# The backend AUTH_ORIGIN must match the frontend's actual browser origin.
# Keep private RPC credentials, database URLs and signing keys out of NEXT_PUBLIC_*.
