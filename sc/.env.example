# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Deployer key (never commit the real one)
PRIVATE_KEY=0xyour_private_key

# Optional overrides (default: the deployer address)
INITIAL_OWNER=
BACKEND_SIGNER=
OPERATOR=
# 100 USDC (6 decimals)
USDC_FAUCET_CLAIM_AMOUNT=100000000
# seconds before an unsettled room can be refunded
REFUND_DELAY=3600
