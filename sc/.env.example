# No private key here: deploys sign with an encrypted keystore account.
#   cast wallet import deployer --interactive
#   npm run deploy:monad        (uses --account deployer)

# Public address of that keystore account (printed by cast wallet import).
DEPLOYER_ADDRESS=

# Optional overrides (default: the deployer address)
INITIAL_OWNER=
BACKEND_SIGNER=
OPERATOR=
# 100 USDC (6 decimals)
USDC_FAUCET_CLAIM_AMOUNT=100000000
# seconds before an unsettled room can be refunded
REFUND_DELAY=3600
